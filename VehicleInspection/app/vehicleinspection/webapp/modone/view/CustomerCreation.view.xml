<mvc:View controllerName="modonecontroller.CustomerCreation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:m="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:grid="sap.ui.layout.Grid"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.uxap">

    <m:Page id="useref" title="Customer and Vehicle Creation" showNavButton="true" navButtonPress="backToLanding">

        <ObjectPageLayout upperCaseAnchorBar="false">
            <sections>
                <ObjectPageSection titleUppercase="false" title="Customer">
                    <ObjectPageSubSection title="Customer" titleUppercase="false">
                        <m:VBox id="customerSection" class="section">
                            <core:Fragment fragmentName="modonefragment.vehicleinspection.Customer" type="XML">
                            </core:Fragment>
                        </m:VBox>
                    </ObjectPageSubSection>
                </ObjectPageSection>

                <ObjectPageSection titleUppercase="false" title="Vehicle">
                    <ObjectPageSubSection title="Vehicle" titleUppercase="false">
                        <m:VBox id="Sectvehicalion" class="section">
                            <core:Fragment fragmentName="modonefragment.vehicleinspection.Vehicle" type="XML">
                            </core:Fragment>
                        </m:VBox>
                    </ObjectPageSubSection>
                </ObjectPageSection>


            </sections>
        </ObjectPageLayout>
        <m:footer>
            <m:Toolbar>
                <m:ToolbarSpacer />
                <m:FlexBox justifyContent="End">
                    <m:Button type="Default" id="cancel" text="Cancel" press="onCancel" />
                    <m:Button type="Emphasized" id="user_btnSubmit" text="Submit" press="onSaveCustomerCreate" class="sapUiSmallMarginBegin"/>
                </m:FlexBox>
            </m:Toolbar>
        </m:footer>
    </m:Page>

</mvc:View>
